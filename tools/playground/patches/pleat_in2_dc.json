{
  "name": "pleat_in2_dc",
  "engine": "pleat",
  "sample_rate": 48000,
  "duration_ms": 180,
  "note": "IN 2 is the DC-coupled input. A positive offset shifts the fold. The output block takes the DC back off.",
  "params": {
    "fold": 1.0,
    "in2": [[0, 0.0], [15, 0.0], [30, 2.0], [180, 2.0]]
  },
  "signals": {
    "host": {"type": "sine", "freq_hz": 300, "amp": 0.8}
  },
  "golden_abs_tol": 1e-5,
  "checks": [
    {
      "id": "centered",
      "type": "asymmetry",
      "jack": "out",
      "t0_ms": 2,
      "t1_ms": 14,
      "max_sum": 0.15
    },
    {
      "id": "in2_shifts",
      "type": "asymmetry",
      "jack": "out",
      "t0_ms": 160,
      "t1_ms": 180,
      "min_sum": 0.05
    },
    {"id": "no_dc", "type": "mean_abs", "jack": "out", "t0_ms": 160, "t1_ms": 180, "max": 0.02}
  ]
}

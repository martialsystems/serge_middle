{
  "name": "bottom_even",
  "engine": "patch",
  "sample_rate": 48000,
  "duration_ms": 200,
  "note": "Bottom at level 1 full-wave rectifies a sine. After the envelope settles the mean is near 0, and OUT 2 is the squared output so it does not match OUT 1.",
  "params": {"bottom_gain": 1.0, "bottom_vc": 1.0},
  "signals": {"bottom_in": {"type": "sine", "freq_hz": 100, "amp": 1.5}},
  "golden_abs_tol": 1e-5,
  "checks": [
    {"id": "alive", "type": "not_silent", "jack": "bottom_out1", "skip_ms": 100, "min_abs": 0.2},
    {"id": "no_dc", "type": "mean_abs", "jack": "bottom_out1", "skip_ms": 100, "max": 0.05},
    {"id": "out2_no_dc", "type": "mean_abs", "jack": "bottom_out2", "skip_ms": 100, "max": 0.05},
    {
      "id": "outs_differ",
      "type": "jacks_differ",
      "jack": "bottom_out1",
      "other_jack": "bottom_out2",
      "skip_ms": 100,
      "min_rms": 0.02
    }
  ]
}

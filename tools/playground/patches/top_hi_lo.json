{
  "name": "top_hi_lo",
  "engine": "patch",
  "sample_rate": 48000,
  "duration_ms": 40,
  "note": "The same sine through top LO, then through top HI. HI is the soft square and does not match LO.",
  "params": {"top_gain": 1.0},
  "signals": {"top_in": {"type": "sine", "freq_hz": 440, "amp": 2.5}},
  "segments": [
    {"t0_ms": 0, "t1_ms": 20, "reset": true, "params": {"top_hi": false, "top_gain": 1.0}},
    {"t0_ms": 20, "t1_ms": 40, "reset": true, "params": {"top_hi": true, "top_gain": 1.0}}
  ],
  "golden_abs_tol": 1e-5,
  "checks": [
    {
      "id": "hi_differs",
      "type": "windows_differ",
      "jack": "top_out",
      "a_ms": [0, 20],
      "b_ms": [20, 40],
      "min_rms": 0.02
    }
  ]
}

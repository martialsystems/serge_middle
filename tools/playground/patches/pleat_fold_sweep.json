{
  "name": "pleat_fold_sweep",
  "engine": "pleat",
  "sample_rate": 48000,
  "duration_ms": 120,
  "note": "Fold sweeps from 0.5 to 8 under a full-scale sine. The manuals describe that sweep as a run of odd harmonics.",
  "params": {
    "fold": [[0, 0.5], [100, 8.0]],
    "in2": 0.0
  },
  "signals": {
    "host": {"type": "sine", "freq_hz": 200, "amp": 1.0}
  },
  "golden_abs_tol": 1e-5,
  "checks": [
    {
      "id": "more_folds",
      "type": "more_peaks",
      "jack": "out",
      "early": [5, 25],
      "late": [100, 120],
      "min_extra": 2
    },
    {"id": "audible", "type": "not_silent", "jack": "out", "min_abs": 0.2}
  ]
}

{
  "name": "cable_top_bottom",
  "engine": "patch",
  "sample_rate": 48000,
  "duration_ms": 40,
  "note": "PLEAT OUT cables into top IN, and top OUT cables into bottom IN. Top passes the folded audio, and the two bottom outputs do not match.",
  "params": {"fold": 1.0, "top_gain": 1.0, "top_hi": false, "bottom_gain": 1.0},
  "signals": {"host": {"type": "sine", "freq_hz": 440, "amp": 1.0}},
  "cables": [
    {"from": "pleat_out", "to": "top_in"},
    {"from": "top_out", "to": "bottom_in"}
  ],
  "golden_abs_tol": 1e-5,
  "checks": [
    {"id": "top", "type": "not_silent", "jack": "top_out", "skip_ms": 15, "min_abs": 0.05},
    {"id": "bottom", "type": "not_silent", "jack": "bottom_out1", "skip_ms": 15, "min_abs": 0.02},
    {
      "id": "outs_differ",
      "type": "jacks_differ",
      "jack": "bottom_out1",
      "other_jack": "bottom_out2",
      "skip_ms": 15,
      "min_rms": 0.01
    }
  ]
}

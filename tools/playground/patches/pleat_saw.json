{
  "name": "pleat_saw",
  "engine": "pleat",
  "sample_rate": 48000,
  "duration_ms": 80,
  "note": "A bipolar saw at full scale, Fold 1.5. Exercises the saw input and the AC-coupled output.",
  "params": {"fold": 1.5, "in2": 0.0},
  "signals": {"host": {"type": "saw", "freq_hz": 150, "amp": 1.0}},
  "golden_abs_tol": 1e-5,
  "checks": [
    {"id": "audible", "type": "not_silent", "jack": "out", "min_abs": 0.3},
    {"id": "no_dc", "type": "mean_abs", "jack": "out", "skip_ms": 60, "max": 0.02}
  ]
}

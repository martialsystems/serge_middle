  "checks": [
    {"id": "in_held", "type": "hold", "jack": "slope2_in", "t0_ms": 0, "t1_ms": 20, "volts": 5.0, "tol": 0.0},
    {"id": "reached", "type": "hold", "jack": "slope2_out", "t0_ms": 8, "t1_ms": 20, "volts": 5.0, "tol": 1e-6},
    {"id": "trig_open", "type": "hold", "jack": "slope2_trig", "t0_ms": 0, "t1_ms": 20, "volts": 0.0, "tol": 0.0}
  ]
}

{
  "name": "bottom_vc_full",
  "engine": "patch",
  "sample_rate": 48000,
  "duration_ms": 40,
  "note": "Level 0 plus VC +5 V at attenuator 1 matches level 1 with no VC. Depth 0 of the same VC stays silent.",
  "params": {"bottom_gain": 0.0, "bottom_vc": 1.0},
  "signals": {
    "bottom_in": {"type": "sine", "freq_hz": 100, "amp": 1.5},
    "bottom_vc": {"type": "dc", "volts": 5.0}
  },
  "segments": [
    {"t0_ms": 0, "t1_ms": 20, "reset": true, "params": {"bottom_gain": 0.0, "bottom_vc": 0.0}},
    {"t0_ms": 20, "t1_ms": 40, "reset": true, "params": {"bottom_gain": 0.0, "bottom_vc": 1.0}}
  ],
  "golden_abs_tol": 1e-5,
  "checks": [
    {"id": "depth0", "type": "silent", "jack": "bottom_out1", "t0_ms": 0, "t1_ms": 20, "max_abs": 0.0},
    {
      "id": "depth1_matches_level",
      "type": "matches_other",
      "jack": "bottom_out1",
      "t0_ms": 20,
      "t1_ms": 40,
      "other": "bottom_level_ref",
      "other_jack": "bottom_out1",
      "other_t0_ms": 0,
      "tol": 1e-12
    }
  ]
}
